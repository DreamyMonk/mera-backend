# Copy to .env.local for local development, and add the same variables in Vercel → Project → Settings → Environment Variables.

# --- Claude (server only; never exposed to users) ---
ANTHROPIC_API_KEY=
# Default model for every user. Can be changed later from the admin dashboard → Settings.
MIRA_MODEL=claude-sonnet-5-5

# --- Admin dashboard (dashboard.dreamymonk.xyz) ---
# The admin login password. Use a long, unique password.
ADMIN_PASSWORD=
# Optional: a separate random secret for signing admin sessions (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# --- Firebase (Firebase console → Project settings) ---
# Web app config (public).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account JSON (Project settings → Service accounts → Generate new private key),
# pasted as one line or base64-encoded.
FIREBASE_SERVICE_ACCOUNT=

# --- Email (Resend: https://resend.com) ---
# API key from Resend → API Keys. Without it, emails are skipped and sign-in codes can't be sent.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend → Domains.
EMAIL_FROM=Mira by dreamymonk <no-reply@dreamymonk.xyz>
# Public address of this site, used for links and images in emails.
APP_URL=https://accounts.dreamymonk.xyz
# Random secret that protects email codes (falls back to ADMIN_SESSION_SECRET).
OTP_SECRET=

# --- Chrome extension ---
# The published extension's id. Only this extension can receive sign-in tokens.
# Leave empty during development (the extension passes its own id).
NEXT_PUBLIC_EXTENSION_ID=
